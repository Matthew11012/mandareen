generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                     @id @default(autoincrement())
  email                String                  @unique
  password_hashed      String
  createdAt            DateTime                @default(now())
  googleId             String?                 @unique
  weeklyGoalLessons    Int?
  betterAuthUser       BetterAuthUser?         @relation("BetterAuthUserLegacyUser")
  activityAttempts     ActivityAttempt[]
  assessments          Assessment[]
  conversations        Conversation[]
  curriculumProgresses CurriculumProgress[]
  flashcards           Flashcard[]
  lessonProgresses     LessonProgress[]
  curriculumBookmark   UserCurriculumBookmark?
  pushSubscriptions    PushSubscription[]
  billingCustomers     BillingCustomer[]
  subscriptions        UserSubscription[]
  usageEvents          UsageEvent[]
  usageDaily           UsageDaily[]
}

model Assessment {
  id          Int      @id @default(autoincrement())
  userId      Int
  levelPlaced Int
  takenAt     DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Lesson {
  id        Int              @id @default(autoincrement())
  level     Int
  title     String?
  createdBy String?
  createdAt DateTime         @default(now())
  tags      String[]         @default([])
  progress  LessonProgress[]
  sections  LessonSection[]

  @@index([tags], type: Gin)
  @@index([createdAt])
  @@index([createdBy])
}

model LessonSection {
  id            Int            @id @default(autoincrement())
  lessonId      Int
  sectionType   String
  content       Json
  lesson        Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  wordInstances WordInstance[]

  @@index([lessonId])
}

model LessonProgress {
  id         Int       @id @default(autoincrement())
  userId     Int
  lessonId   Int
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  lesson     Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model VocabularyItem {
  id          Int               @id @default(autoincrement())
  hanzi       String            @unique
  pinyin      String
  pinyin_search String?
  definition  String
  createdAt   DateTime          @default(now())
  frequency   Int?
  hskLevel    Int?
  isCustom    Boolean           @default(false)
  source      String?
  traditional String?
  flashcards  Flashcard[]
  senses      VocabularySense[]
  instances   WordInstance[]

  @@index([hanzi])
  @@index([pinyin_search])
  @@index([hskLevel])
  @@index([source])
}

model WordInstance {
  id         Int            @id @default(autoincrement())
  sectionId  Int?
  vocabId    Int
  startIndex Int
  endIndex   Int
  context    String
  createdAt  DateTime       @default(now())
  messageId  Int?
  flashcards Flashcard[]
  message    Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  section    LessonSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  vocab      VocabularyItem @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([vocabId])
}

model Flashcard {
  id               Int                 @id @default(autoincrement())
  userId           Int
  vocabId          Int
  sourceInstanceId Int?
  nextReview       DateTime
  intervalDays     Int
  easiness         Float
  createdAt        DateTime            @default(now())
  sourceInstance   WordInstance?       @relation(fields: [sourceInstanceId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab            VocabularyItem      @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  sentences        FlashcardSentence[]
  reviews          Review[]

  @@index([userId, nextReview])
  @@index([userId, createdAt])
  @@index([userId, easiness])
}

model Review {
  id          Int       @id @default(autoincrement())
  flashcardId Int
  reviewedAt  DateTime  @default(now())
  quality     Int
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId])
}

model FlashcardSentence {
  id          Int       @id @default(autoincrement())
  flashcardId Int
  hanzi       String
  pinyin      String?
  translation String?
  createdAt   DateTime  @default(now())
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  startedAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             Int            @id @default(autoincrement())
  conversationId Int
  role           String
  hanzi          String
  pinyin         String
  translation    String
  audioUrl       String?
  createdAt      DateTime       @default(now())
  notes          Json?
  segments       Json?
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  wordInstances  WordInstance[]
}

/// RAG: Knowledge sources and chunks for grounded generation
model RagSource {
  id              Int              @id @default(autoincrement())
  title           String
  sourceType      String
  language        String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  curriculumUnits CurriculumUnit[]
  chunks          RagChunk[]
  sections        RagSection[]
}

model RagSection {
  id                Int                @id @default(autoincrement())
  sourceId          Int
  heading           String?
  slug              String?
  tags              String[]
  hskMin            Int?
  hskMax            Int?
  metadata          Json?
  createdAt         DateTime           @default(now())
  curriculumLessons CurriculumLesson[]
  chunks            RagChunk[]
  source            RagSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model RagChunk {
  id           Int            @id @default(autoincrement())
  sourceId     Int
  sectionId    Int
  hanzi        String?
  english      String?
  tokens       Int?
  tags         String[]
  hskMin       Int?
  hskMax       Int?
  createdAt    DateTime       @default(now())
  embeddingZh  Json?
  embeddingEn  Json?
  section      RagSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  source       RagSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  RagEmbedding RagEmbedding[]

  @@index([sourceId])
  @@index([sectionId])
  @@index([hskMin, hskMax])
}

model VocabularySense {
  id               Int            @id @default(autoincrement())
  vocabularyItemId Int
  pinyin           String?
  definition       String
  createdAt        DateTime       @default(now())
  vocabularyItem   VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([vocabularyItemId, pinyin, definition])
  @@index([vocabularyItemId])
}

model RagEmbedding {
  id        Int                    @id @default(autoincrement())
  chunkId   Int
  kind      String
  dimension Int
  vector    Unsupported("vector")?
  RagChunk  RagChunk               @relation(fields: [chunkId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([chunkId, kind])
  @@index([vector], map: "ragembedding_vector_hnsw")
}

model CurriculumUnit {
  id             Int                      @id @default(autoincrement())
  ragSourceId    Int
  title          String
  description    String?
  order          Int                      @default(0)
  targetLevelMin Int?                     @default(0)
  targetLevelMax Int?                     @default(7)
  createdAt      DateTime                 @default(now())
  metadata       Json?
  lessons        CurriculumLesson[]
  progresses     CurriculumProgress[]
  ragSource      RagSource                @relation(fields: [ragSourceId], references: [id], onDelete: Cascade)
  bookmarks      UserCurriculumBookmark[]

  @@unique([ragSourceId, title])
  @@index([ragSourceId, order])
}

model CurriculumLesson {
  id           Int                      @id @default(autoincrement())
  unitId       Int
  ragSectionId Int?
  title        String
  description  String?
  order        Int                      @default(0)
  objectives   Json?
  grammarKeys  String[]
  createdAt    DateTime                 @default(now())
  metadata     Json?
  activities   CurriculumActivity[]
  ragSection   RagSection?              @relation(fields: [ragSectionId], references: [id], onDelete: Cascade)
  unit         CurriculumUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  progresses   CurriculumProgress[]
  bookmarks    UserCurriculumBookmark[]

  @@unique([unitId, ragSectionId])
  @@unique([unitId, title])
  @@index([unitId])
  @@index([unitId, order])
  @@index([ragSectionId])
}

model CurriculumActivity {
  id         Int                      @id @default(autoincrement())
  lessonId   Int
  type       CurriculumActivityType
  version    Int                      @default(1)
  levelBand  Int                      @default(0)
  content    Json
  order      Int                      @default(0)
  createdAt  DateTime                 @default(now())
  attempts   ActivityAttempt[]
  lesson     CurriculumLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progresses CurriculumProgress[]
  bookmarks  UserCurriculumBookmark[]

  @@unique([lessonId, type, version, levelBand])
  @@index([lessonId, type])
}

model CurriculumProgress {
  id         Int                      @id @default(autoincrement())
  userId     Int
  unitId     Int?
  lessonId   Int?
  activityId Int?
  status     CurriculumProgressStatus
  score      Int?
  attempts   Int                      @default(0)
  updatedAt  DateTime                 @updatedAt
  createdAt  DateTime                 @default(now())
  activity   CurriculumActivity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lesson     CurriculumLesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unit       CurriculumUnit?          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, unitId])
  @@index([userId, lessonId])
  @@index([userId, activityId])
  @@index([userId, status])
}

model ActivityAttempt {
  id         Int                @id @default(autoincrement())
  userId     Int
  activityId Int
  payload    Json
  score      Int?
  createdAt  DateTime           @default(now())
  activity   CurriculumActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityId])
}

model UserCurriculumBookmark {
  id         Int                 @id @default(autoincrement())
  userId     Int                 @unique
  unitId     Int?
  lessonId   Int?
  activityId Int?
  updatedAt  DateTime            @updatedAt
  activity   CurriculumActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lesson     CurriculumLesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unit       CurriculumUnit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CurriculumActivityType {
  READ
  VOCAB
  GRAMMAR
  QUIZ
  LISTEN
  SPEAK
}

enum CurriculumProgressStatus {
  in_progress
  completed
}

model PushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Billing, Plans, and Usage Metering Models
// ============================================================================

model Plan {
  id                 Int              @id @default(autoincrement())
  code               String           @unique // FREE, BASIC, PREMIUM
  name               String
  description        String?
  periodUnit         String           @default("monthly") // flexible for future
  displayPriceCents  Int
  currency           String           @default("USD")
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  limits             PlanLimit[]
  features           PlanFeature[]
  prices             PlanPrice[]
  subscriptions      UserSubscription[]

  @@index([code])
  @@index([isActive])
}

model PlanLimit {
  id          Int    @id @default(autoincrement())
  planId      Int
  resource    String
  monthlyCap  Int                  // hard ceiling over rolling window
  rpm         Int?                 // requests per minute (advisory for Phase 2)
  burst       Int?                 // burst tokens (advisory for Phase 2)
  concurrency Int?                 // max concurrent ops per user (advisory)
  plan        Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, resource])
  @@index([planId, resource])
}

model PlanFeature {
  id      Int     @id @default(autoincrement())
  planId  Int
  key     String
  enabled Boolean @default(true)
  value   Json?
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId, key])
}

model PlanPrice {
  id                Int     @id @default(autoincrement())
  planId            Int
  provider          String  // 'polar', 'stripe', etc.
  externalPriceId   String
  billingPeriod     String  @default("monthly")
  currency          String  @default("USD")
  unitAmountCents   Int
  isActive          Boolean @default(true)
  plan              Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([provider, externalPriceId])
  @@index([planId, provider])
}

model BillingCustomer {
  id                 Int      @id @default(autoincrement())
  userId             Int
  provider           String
  externalCustomerId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalCustomerId])
  @@unique([provider, userId])
  @@index([userId])
  @@index([provider])
}

model UserSubscription {
  id                     Int      @id @default(autoincrement())
  userId                 Int
  planId                 Int
  provider               String   // 'polar'
  externalSubscriptionId String?
  status                 String   // 'active'|'trialing'|'canceled'|'past_due'...
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([externalSubscriptionId])
  @@index([provider])
}

model BillingEvent {
  id          Int      @id @default(autoincrement())
  provider    String
  eventId     String
  type        String
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  status      String   @default("pending") // 'pending'|'processed'|'failed'|'skipped'

  @@unique([provider, eventId])
  @@index([provider, status])
  @@index([processedAt])
}

model UsageEvent {
  id         BigInt   @id @default(autoincrement())
  userId     Int
  resource   String
  delta      Int      // count or seconds; canonical per resource
  occurredAt DateTime @default(now())
  traceId    String?
  metadata   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource, occurredAt])
  @@index([traceId])
}

model UsageDaily {
  id       BigInt   @id @default(autoincrement())
  userId   Int
  resource String
  day      DateTime // UTC midnight
  used     Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, day])
  @@index([userId, resource, day])
}

model ConcurrencyLock {
  key        String   @id // e.g., user:{id}:convo:stream
  userId     Int
  resource   String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  metadata   Json?

  @@index([userId, resource])
  @@index([expiresAt])
}

// ============================================================================
// Better Auth Tables
// ============================================================================

model BetterAuthUser {
  id            String               @id @default(cuid())
  name          String?
  email         String               @unique
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  legacyUserId  Int?                 @unique
  legacyUser    User?                @relation("BetterAuthUserLegacyUser", fields: [legacyUserId], references: [id])
  sessions      BetterAuthSession[]
  accounts      BetterAuthAccount[]

  @@index([email])
}

model BetterAuthSession {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BetterAuthAccount {
  id                   String         @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  idToken              String?
  password             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId, providerId])
}

model BetterAuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}
